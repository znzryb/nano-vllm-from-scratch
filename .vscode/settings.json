{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.languageServer": "None",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.callArgumentNames": "partial",
  "python.pyrefly.disableLanguageServices": false,
  "python.pyrefly.disableTypeErrors": false,
  "python.pyrefly.diagnosticMode": "openFilesOnly",
  "python.pyrefly.runnableCodeLens": true,
  "pyrefly.pyreflyExecutable": "bundled",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.cwd": "${workspaceFolder}",
  "ruff.enable": true,
  "ruff.importStrategy": "useBundled",
  "ruff.exclude": [".venv/**", "references/**"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.inlayHints.enabled": "on",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.fixAll": "never",
      "source.organizeImports": "never",
      "source.fixAll.ruff": "never",
      "source.organizeImports.ruff": "never",
      "source.fixAll.pyrefly": "never"
    }
  }
}
